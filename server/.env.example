# PMSS server — copy to `.env` for local/production

PORT=3001
NODE_ENV=development

# Required in production (generate: openssl rand -hex 32)
JWT_SECRET=change-me-in-production
JWT_EXPIRES=12h

# Pilot “today” for TL/VTL duty windows (ISO date)
PMSS_TODAY=2026-08-02

# Optional: SQLite path (default server/data/pmss.sqlite)
# PMSS_DB_PATH=

# CORS — set to your UI origin if API and UI are on different hosts
# CORS_ORIGIN=http://localhost:5173

# Set for unified production (API + UI on one port)
SERVE_WEB=1
NODE_ENV=production
