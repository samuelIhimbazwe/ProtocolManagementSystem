# PMSS server — copy to `.env` for local/production

PORT=3001
NODE_ENV=development

# Required in production (generate: openssl rand -hex 32)
JWT_SECRET=change-me-in-production
JWT_EXPIRES=12h

# Pilot “today” for TL/VTL duty windows (ISO date)
PMSS_TODAY=2026-08-02

# Neon / Postgres — when set, SQLite is not used
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional: SQLite path when DATABASE_URL is unset (default server/data/pmss.sqlite)
# PMSS_DB_PATH=

# CORS — Vercel origin in split deploy (comma-separated allowed)
# CORS_ORIGIN=https://your-app.vercel.app

# SERVE_WEB=0 on Render (API only). SERVE_WEB=1 for local unified API+UI.
SERVE_WEB=0
